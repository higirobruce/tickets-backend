# ---- Server ----
# Port the Express server listens on (default 8081)
PORT=8081

# ---- Database ----
# MongoDB connection string (falls back to mongodb://localhost:27017/tickets)
TICKETS_DB=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tickets?retryWrites=true&w=majority

# ---- Auth ----
# Secret used to sign and verify the JWTs issued by POST /users/login.
# Required in production; a throwaway dev secret is used otherwise.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (jsonwebtoken format), default 12h
JWT_EXPIRES_IN=12h
# Legacy shared PBKDF2 salt for accounts created before per-user salts.
# Leave unset unless you know the original value; new accounts get their own salt.
# PASSWORD_SALT=

# ---- CORS ----
# Comma-separated browser origins allowed to call the API. Unset = any origin (development only).
CORS_ORIGIN=http://localhost:3000

# ---- URLs ----
# Public URL of this backend, embedded in ticket QR codes as
# ${TICKETS_BCKEND_URL}/tickets/validate/<number>
TICKETS_BCKEND_URL=http://localhost:8081
# Public URL of the web app that QR/SMS links redirect to
TICKETS_WEB_URL=http://localhost:3000

# ---- Payments ----
# Enabled providers, comma list: "momo,lumicash" | "momo" | "lumicash" | "mock". Unset = momo.
# "mock" treats every purchase as paid (testing only). A missing/unknown provider config stops boot.
PAYMENT_PROVIDERS=momo
# DEPRECATED alias for PAYMENT_PROVIDERS=mock; use PAYMENT_PROVIDERS instead.
# PAYMENTS_MODE=mock
# Currencies MoMo accepts, comma list (default RWF; the MTN sandbox needs EUR)
MOMO_CURRENCIES=RWF

# ---- MTN MoMo Collections API (routes/routeMomo.ts) ----
# Sandbox: https://sandbox.momodeveloper.mtn.com   Production: https://proxy.momoapi.mtn.com
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# Primary subscription key from the MoMo developer portal
MOMO_SUBSCRIPTION_KEY=
# "sandbox" or "mtnrwanda"
MOMO_ENVIRONMENT=sandbox
# API user UUID (sent as X-Reference-Id on the token call)
MOMO_API_USER=
# base64("<API user UUID>:<API key>") used for the /collection/token/ call
MOMO_BASIC_AUTH=

# ---- Lumicash (services/providers/lumicash.ts; required when PAYMENT_PROVIDERS includes lumicash) ----
# Lumicash API base URL
LUMICASH_BASE_URL=
# HTTP Basic credentials for the Lumicash API
LUMICASH_BASIC_USER=
LUMICASH_BASIC_PASS=
# Partner identifier issued by Lumicash
LUMICASH_PARTNER=
# Agent account used to collect payments
LUMICASH_AGENT_MOBILE=
LUMICASH_AGENT_CODE=
LUMICASH_AGENT_PASSWORD=
# Key used to sign requests
LUMICASH_SIGN_KEY=
# Service id for status checks (the spelling is Lumicash's own)
LUMICASH_SERVICE_ID=CHECK_TRANSATION
# Phone format sent to Lumicash: "international" or "local" (international confirmed in sandbox)
LUMICASH_MSISDN_FORMAT=international
# Request timeout in milliseconds
LUMICASH_TIMEOUT_MS=10000

# ---- Email (optional; ticket copies and password-reset links) ----
# Leave SMTP_HOST unset to send nothing by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EvenTixr <tickets@example.com>"
# Timezone used when formatting dates in emails and exports
EVENT_TIMEZONE=Africa/Kigali

# ---- SMS routes (services/sms/routes.ts) ----
# Countries (dial codes) with their own SMS route. Unset = the legacy SMS_* keys below act as the 250 route.
SMS_ROUTES=250,257
# Per-country provider, credentials, sender ID, message language and failure-notice number
SMS_250_PROVIDER=africastalking
SMS_250_USERNAME=
SMS_250_API_KEY=
SMS_250_SENDER_ID=EVENTIXR
SMS_250_LANG=rw
SMS_250_FALLBACK_NUMBER=
SMS_257_PROVIDER=africastalking
SMS_257_USERNAME=
SMS_257_API_KEY=
SMS_257_SENDER_ID=
SMS_257_LANG=fr
SMS_257_FALLBACK_NUMBER=

# ---- Africa's Talking SMS, legacy keys (the 250 route when SMS_ROUTES is unset) ----
SMS_API_USERNAME=sandbox
SMS_API_KEY=
# Registered sender ID (default Shapeherd)
SMS_SENDER_ID=Shapeherd
# Optional number that gets a notice when an SMS fails to send
SMS_FALLBACK_NUMBER=
